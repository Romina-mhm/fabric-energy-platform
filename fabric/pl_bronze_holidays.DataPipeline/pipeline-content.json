          {
            "activity": "lkp_countries",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "ForEach",
        "typeProperties": {
          "batchCount": 4,
          "items": {
            "value": "@activity('flt_active').output.Value",
            "type": "Expression"
          },
          "activities": [
            {
              "type": "Copy",
              "typeProperties": {
                "source": {
                  "type": "RestSource",
                  "requestMethod": "GET",
                  "paginationRules": {
                    "supportRFC5988": "true"
                  },
                  "httpRequestTimeout": "00:01:40",
                  "requestInterval": "00.00:00:00.010",
                  "datasetSettings": {
                    "type": "RestResource",
                    "typeProperties": {
                      "relativeUrl": "@concat('PublicHolidays/', variables('v_year'), '/', item().country_code)"
                    },
                    "schema": [],
                    "externalReferences": {
                      "connection": "cd325be5-c034-46ab-a3ed-cb476d288951"
                    },
                    "annotations": []
                  }
                },
                "sink": {
                  "type": "JsonSink",
                  "formatSettings": {
                    "type": "JsonWriteSettings",
                    "filePattern": "arrayOfObjects"
                  },
                  "storeSettings": {
                    "type": "LakehouseWriteSettings"
                  },
                  "datasetSettings": {
                    "type": "Json",
                    "typeProperties": {
                      "location": {
                        "type": "LakehouseLocation",
                        "folderPath": {
                          "value": "@concat('raw/holidays/', variables('v_year'))",
                          "type": "Expression"
                        },
                        "fileName": {
                          "value": "@concat('public_holidays__', item().country_code, '__', variables('v_year'), '.json')",
                          "type": "Expression"
                        }
                      }
                    },
                    "schema": {},
                    "linkedService": {
                      "name": "lh_bronze",
                      "properties": {
                        "type": "Lakehouse",
                        "typeProperties": {
                          "artifactId": "0a7c6fb8-0ebf-9ebb-4546-f37f82f9a133",
                          "workspaceId": "00000000-0000-0000-0000-000000000000",
                          "rootFolder": "Files"
                        },
                        "annotations": []
                      }
                    },
                    "annotations": []
                  }
                },
                "enableStaging": false
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "copy_holidays",
              "dependsOn": []
            }
          ]
        },
        "name": "for_each_country",
        "dependsOn": [
          {
            "activity": "flt_active",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
