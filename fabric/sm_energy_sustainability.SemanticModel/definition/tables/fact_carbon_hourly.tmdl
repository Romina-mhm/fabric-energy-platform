/// Hourly carbon metrics per country: generation, renewable and low-carbon energy, CO2e.
table fact_carbon_hourly
	lineageTag: 2a22e47a-0c03-4287-b58b-7ecc1235171d
	sourceLineageTag: [fact].[fact_carbon_hourly]

	/// Electricity generated, in MWh, all fuel types.
	measure 'Total Generation MWh' = SUM ( fact_carbon_hourly[total_generation_mwh] )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Carbon
		lineageTag: e1db860e-8182-4510-9b31-7c6bf097e669

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Share of total generation from renewable sources (wind, solar, hydro, biomass, geothermal).
	measure 'Renewable %' =
			
			DIVIDE ( SUM ( fact_carbon_hourly[renewable_mwh] ), [Total Generation MWh] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Carbon
		lineageTag: 273a8f33-595e-4f49-a3b6-63a6bc4b4d2d

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = Description

		changedProperty = FormatString

	/// Share of generation from renewables plus nuclear.
	measure 'Low-carbon %' =
			
			DIVIDE ( SUM ( fact_carbon_hourly[low_carbon_mwh] ), [Total Generation MWh] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Carbon
		lineageTag: 545f1ee6-5b21-4c96-9ad2-eeaaa3f054d9

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

	/// Lifecycle grams CO2e per kWh generated, calculated only over generation with a known emission factor. Read together with Factor Coverage %.
	measure 'Carbon Intensity gCO2e/kWh' =
			
			DIVIDE ( SUM ( fact_carbon_hourly[co2e_kg] ), SUM ( fact_carbon_hourly[factor_covered_mwh] ) )
		displayFolder: Carbon
		lineageTag: 5f2dfde2-f9d9-4fb4-b857-705412ee05e5

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = Description

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Share of generation that has a known emission factor. Below ~90% the carbon intensity is less reliable (e.g. NL 'Other').
	measure 'Factor Coverage %' =
			
			DIVIDE ( SUM ( fact_carbon_hourly[factor_covered_mwh] ), [Total Generation MWh] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Carbon
		lineageTag: 3a92d4f3-f68e-4b8c-8820-519189c9c531

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = Description

		changedProperty = FormatString

	/// Lifecycle greenhouse-gas emissions of generation in tonnes CO2-equivalent; only generation with a known emission factor.
	measure 'Total CO2e tonnes' = DIVIDE ( SUM ( fact_carbon_hourly[co2e_kg] ), 1000 )
		displayFolder: Carbon
		lineageTag: af09b043-c863-488e-9fda-fdf2de5fa007

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = Description

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Hour of day (0–23, UTC) with the lowest carbon intensity in the current filter.
	measure 'Greenest Hour' =
			
			VAR t =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( dim_hour[hour_key] ), "@ci", [Carbon Intensity gCO2e/kWh] ),
			        NOT ISBLANK ( [@ci] )
			    )
			RETURN MINX ( TOPN ( 1, t, [@ci], ASC ), dim_hour[hour_key] )
		formatString: 0
		displayFolder: Carbon
		lineageTag: b8167242-de53-4201-b545-812cccb4be08

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = Description

