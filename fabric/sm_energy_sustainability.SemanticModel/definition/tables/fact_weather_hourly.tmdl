/// Hourly weather (wind, solar radiation, temperature) per country.
table fact_weather_hourly
	lineageTag: 10b98024-e3c4-41af-a622-7f79c73ebadd
	sourceLineageTag: [fact].[fact_weather_hourly]

	/// Average wind speed at 100 m height in km/h (weather data, not wind power generation). Use for questions about wind conditions or weather.
	measure 'Avg Wind 100m km/h' = AVERAGE ( fact_weather_hourly[wind_speed_100m_kmh] )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Weather
		lineageTag: 619225e5-da59-4292-9724-c60910be3902

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Solar W/m2' = AVERAGE ( fact_weather_hourly[solar_radiation_wm2] )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Weather
		lineageTag: 318be1c4-d5c2-415b-980a-fdffc46322f9

