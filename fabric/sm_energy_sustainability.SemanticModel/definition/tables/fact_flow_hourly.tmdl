table fact_flow_hourly
	lineageTag: 56214175-29d5-4c64-802b-36a1258d0605
	sourceLineageTag: [fact].[fact_flow_hourly]

	measure 'Exports MWh' = SUM ( fact_flow_hourly[flow_mwh] )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Market
		lineageTag: ca9d2f83-c595-4cdc-b095-eab22e9a7f2a

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Imports MWh' =
			
			CALCULATE (
			    SUM ( fact_flow_hourly[flow_mwh] ),
			    USERELATIONSHIP ( fact_flow_hourly[to_country_code], dim_country[country_code] )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Market
		lineageTag: 691247d0-1e29-4204-b535-d7544c5e9ae8

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Imports minus exports across all borders. Positive means the country imports more than it exports.
	measure 'Net Imports MWh' = [Imports MWh] - [Exports MWh]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Market
		lineageTag: 6fcd557a-a3fa-467f-a66b-af6fc5a92097

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

