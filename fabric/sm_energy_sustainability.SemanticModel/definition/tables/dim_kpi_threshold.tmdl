/// Official 2030 renewable targets and alert levels per country.
table dim_kpi_threshold
	lineageTag: c8832790-045a-439d-955e-428bd3acf00b
	sourceLineageTag: [dim].[dim_kpi_threshold]

	/// Official national 2030 renewable electricity target (DE 80%, IT 63.4%, NL 70%, FR 40%).
	measure 'Renewable Target %' = DIVIDE ( MAX ( dim_kpi_threshold[renewable_share_target_pct] ), 100 )
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: Targets
		lineageTag: d93dcfcb-6945-44c3-a779-b1a20965c855

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

	measure 'Renewable Gap vs Target' = [Renewable %] - [Renewable Target %]
		displayFolder: Targets
		lineageTag: 842c3c76-7509-4c76-b5a3-d4b6a283c13b

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Carbon Alert Level' = MAX ( dim_kpi_threshold[carbon_intensity_alert_gco2e_per_kwh] )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Targets
		lineageTag: 42df4275-7f11-4ef1-b1cd-48a88fc86da1

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

