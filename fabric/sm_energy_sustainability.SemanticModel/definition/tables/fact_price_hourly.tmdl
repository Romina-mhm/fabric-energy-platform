/// Hourly day-ahead wholesale prices per bidding zone.
table fact_price_hourly
	lineageTag: 0b1f83da-fd68-41d0-9597-f3a41b10f2ba
	sourceLineageTag: [fact].[fact_price_hourly]

	/// Average hourly day-ahead wholesale electricity price in EUR per MWh.
	measure 'Avg Price EUR/MWh' = AVERAGE ( fact_price_hourly[price_eur_mwh] )
		formatString: "€"\ #,0.0;-"€"\ #,0.0;"€"\ #,0.0
		displayFolder: Market
		lineageTag: 13a7ae89-2ad1-43f8-bad3-d4361b329f30

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

	/// Number of hours with a day-ahead price below zero.
	measure 'Negative Price Hours' =
			
			CALCULATE ( COUNTROWS ( fact_price_hourly ), fact_price_hourly[price_eur_mwh] < 0 )
		formatString: 0
		displayFolder: Market
		lineageTag: 37ead2fc-1101-4de5-b056-8e596e680b5f

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = Description

